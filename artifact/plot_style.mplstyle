figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.edgecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.dpi: 220
axes.edgecolor: "#D8D1C7"
axes.labelcolor: "#4B5563"
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.titlesize: 10
axes.labelsize: 9.5
grid.color: "#E7E5E4"
grid.linewidth: 0.65
grid.alpha: 0.65
font.size: 9
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
xtick.color: "#6B7280"
ytick.color: "#6B7280"
xtick.labelsize: 8
ytick.labelsize: 8
legend.frameon: False
legend.fontsize: 8
lines.linewidth: 1.8
lines.markersize: 4
patch.linewidth: 0.0
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
